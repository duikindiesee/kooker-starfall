* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
# Unity's serializer emits spaces after empty YAML values.
*.meta text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.unity text eol=lf whitespace=-blank-at-eol
# Preserve the publisher's licence text bytes, including its original whitespace.
Assets/CityLife/Art/Licenses/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
Assets/CityLife/Art/THIRD-PARTY-NOTICES.txt -text whitespace=-blank-at-eol,-blank-at-eof
*.png binary
*.jpg binary
# Keep the reviewed manual probe's SHA256 evidence stable across Windows checkouts.
evidence/milestones/hybrid-npc/manual-real-30s-20260913/npc-runtime.json -text
evidence/milestones/hybrid-npc/manual-real-30s-20260913/real-local-probe.json -text
